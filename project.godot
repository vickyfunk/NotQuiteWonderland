[input_devices]

sensors/enable_accelerometer=true
sensors/enable_gravity=true

[layer_names]

3d_physics/layer_1="World"
3d_physics/layer_2="Player"
3d_physics/layer_3="Objects"
3d_physics/layer_4="Weapons"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

environment/ssao/quality=0
environment/defaults/default_clear_color=Color(0.58103293, 0.581033, 0.58103275, 1)
