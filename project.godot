; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="NotQuiteWonderlandPrototype"
run/main_scene="res://Scenes/testscene.tscn"
config/features=PackedStringArray("4.5", "C#", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

CyclopsAutoload="*res://addons/cyclops_level_builder/cyclops_global_scene.tscn"

[dialogic]

directories/dch_directory={}
directories/dtl_directory={}

[display]

window/size/viewport_width=640
window/size/viewport_height=480
window/size/initial_position_type=0
window/size/always_on_top=true
window/stretch/mode="canvas_items"
window/per_pixel_transparency/allowed=true

[dotnet]

project/assembly_name="NotQuiteWonderland"

[editor_plugins]

enabled=PackedStringArray("res://addons/anim_player_refactor/plugin.cfg", "res://addons/asset_placer/plugin.cfg", "res://addons/cyclops_level_builder/plugin.cfg", "res://addons/deformablemesh/plugin.cfg", "res://addons/gui_auto_layout/plugin.cfg", "res://addons/material_generator/plugin.cfg", "res://addons/physical_audio_3d/plugin.cfg", "res://addons/script_splitter/plugin.cfg", "res://addons/trigger_manager/plugin.cfg", "res://addons/verlet_rope_4/plugin.cfg", "res://addons/wigglebone/plugin.cfg")

[filesystem]

import/fbx/enabled=false

[importer_defaults]

animation_library={
&"animation/fps": 60.0,
&"blender/meshes/colors": true,
&"blender/meshes/export_bones_deforming_mesh_only": true,
&"blender/meshes/export_geometry_nodes_instances": true,
&"blender/meshes/skins": 1
}

